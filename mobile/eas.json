{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": { "APP_ENV": "development" }
    },
    "staging": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging",
      "env": { "APP_ENV": "staging" }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    }
  }
}
